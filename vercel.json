{
  "framework": null,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": [
        "frontend/**",
        "**/scipy/spatial/**",
        "**/scipy/signal/**",
        "**/scipy/ndimage/**",
        "**/scipy/fft/**",
        "**/scipy/cluster/**",
        "**/scipy/interpolate/**",
        "**/scipy/stats/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
